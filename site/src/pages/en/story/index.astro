---
import BaseLayout from "../../../layouts/BaseLayout.astro"
import Header from "../../../components/Header.astro"

const base = import.meta.env.BASE_URL;
const href = (p) => `${base}${p.replace(/^\//, "")}`;

const MARK = {
  gdev: { alt: "Google Developers", src: "https://commons.wikimedia.org/wiki/Special:FilePath/Google%20Developers%20logo.svg" },
  msft: { alt: "Microsoft", src: "https://commons.wikimedia.org/wiki/Special:FilePath/Microsoft%20logo%20(2012).svg" },
  upwork: { alt: "Upwork", src: "https://commons.wikimedia.org/wiki/Special:FilePath/Upwork-Logo-Black.svg" },
  healthvectors: { alt: "Health Vectors", src: href("logos/healthvectors.svg") },
  rwth: { alt: "RWTH Aachen", src: "https://commons.wikimedia.org/wiki/Special:FilePath/RWTH%20Logo%203.svg" },
  infineon: { alt: "Infineon", src: "https://commons.wikimedia.org/wiki/Special:FilePath/Infineon-Logo.svg" },
  generali: { alt: "Generali", src: "https://commons.wikimedia.org/wiki/Special:FilePath/Generali%20wordmark%20logo.svg" },
  epg: { alt: "EPG", src: "https://commons.wikimedia.org/wiki/Special:FilePath/Logo%20der%20Ehrhardt%20Partner%20Group.svg" },
}

const markClass = (key) => (key === "generali" ? "mark" : "mark markLg")

const chapters = [
  {
    id: "start",
    title: "Where it started",
    location: { label: "Jodhpur, India", href: "https://en.wikipedia.org/wiki/Jodhpur" },
    marks: ["gdev", "msft"],
    body: [
      "I am Kunal. I care about innovation, digitalization, and IT management that changes how organizations operate.",
      "My journey began in India during my Bachelor’s in Computer Science Engineering. I was not just studying. I was building communities, bringing people together, setting learning goals, and keeping the energy alive.",
      "That early phase shaped how I work today. I learn fast, build systems, and focus on creating environments where people grow."
    ],
    milestones: [
      "Bachelor’s in Computer Science Engineering",
      "Leadership through student communities and events",
      "Large hackathons, including one with over 400 participants"
    ],
  },
  {
    id: "school",
    title: "School years in Jodhpur",
    marks: [],
    body: [
      "I studied at Delhi Public School in Jodhpur. It gave me structure, discipline, and a strong academic base.",
      "It was also where I began balancing academics with leadership and extracurricular work."
    ],
    milestones: [
      "Schooling at Delhi Public School, Jodhpur",
      "Early focus on leadership and structured learning"
    ],
  },
  {
    id: "entrepreneurship",
    title: "Getting my hands dirty with entrepreneurship",
    marks: ["upwork"],
    body: [
      "Alongside my studies, I wanted to build something of my own. I started freelancing and delivering software services.",
      "It was not only about code. I learned client management, requirements, and how to run projects in the real world.",
      "Working with a development agency pushed me toward product and project management thinking early."
    ],
    milestones: [
      "Freelancing and software services",
      "Client communication and project delivery",
      "Product and project management exposure through agency work"
    ],
  },
  {
    id: "health",
    title: "Health tech and data work",
    location: { label: "Bangalore, India", href: "https://en.wikipedia.org/wiki/Bangalore" },
    marks: ["healthvectors"],
    body: [
      "After graduating, I joined Health Vectors in Bangalore as a Software Engineer in Data Science.",
      "I built systems that turned messy medical reports into structured insights and reliable workflows.",
      "We also developed a health scoring system to improve underwriting decisions."
    ],
    milestones: [
      "Software Engineer in Data Science at Health Vectors",
      "Data workflows around medical reports and decision support",
      "Health scoring system linked to underwriting use cases"
    ],
  },
  {
    id: "chatgpt",
    title: "When AI shifted the lens",
    marks: [],
    body: [
      "When GPT 3.5 launched, it shifted how I thought about what teams could deliver.",
      "I started focusing more on innovation, digitalization, and how organizations can move faster without chaos.",
      "That is when management became as exciting as engineering."
    ],
    milestones: [
      "Shift toward innovation and digitalization thinking",
      "More focus on process, project, and IT management",
      "Clearer direction toward business and transformation roles"
    ],
  },
  {
    id: "germany",
    title: "Germany and the MBA chapter",
    location: { label: "Aachen, Germany", href: "https://en.wikipedia.org/wiki/Aachen" },
    marks: ["rwth"],
    body: [
      "I learned German for 2.5 years while working because I wanted to study in Germany.",
      "I moved to RWTH Aachen for my MBA in Digitalization and Industrial Change and received the Entrepreneurial Mindset Scholarship.",
      "At RWTH I immersed myself in strategy, innovation, and industry labs with a strong focus on execution."
    ],
    milestones: [
      "MBA at RWTH Aachen in Digitalization and Industrial Change",
      "Entrepreneurial Mindset Scholarship",
      "Strategy labs with industry involvement and top grade outcomes"
    ],
  },
  {
    id: "capstone",
    title: "Capstone and thesis",
    marks: ["infineon"],
    body: [
      "The final semester centered on a capstone with Infineon and my master’s thesis.",
      "We focused on sustainable innovation and business model design for circular economy challenges.",
      "The project earned an internal innovation award when we presented it to the company."
    ],
    milestones: [
      "Capstone project with Infineon",
      "Innovation award for the team presentation",
      "Strong outcome focus and top grades"
    ],
  },
  {
    id: "generali",
    title: "Seeing enterprise innovation up close",
    marks: ["generali"],
    body: [
      "During my master’s, I worked part time as a Network Automation Engineer at Assicurazioni Generali.",
      "It showed me how innovation looks inside a large organization and why governance matters when you want innovation to scale.",
      "This experience shaped my thesis and made the topic feel real, not academic."
    ],
    milestones: [
      "Network automation work in an enterprise environment",
      "Direct exposure to innovation challenges at corporate level",
      "Thesis direction shaped by real governance constraints"
    ],
  },
  {
    id: "now",
    title: "Where I am now",
    location: { label: "Alzenau, Germany", href: "https://en.wikipedia.org/wiki/Alzenau" },
    marks: ["epg"],
    body: [
      "After graduating, I joined EPG as a Junior Software Developer.",
      "I am building my career in Germany and learning how German organizations work from the inside.",
      "I am aiming for roles in consulting, product, or project management where tech and business meet."
    ],
    milestones: [
      "Junior Software Developer at EPG",
      "Learning how German organizations operate",
      "Target roles in consulting, product, or project management"
    ],
  },
]
---

<BaseLayout title="My Story, Kunal Gehlot" lang="en">
  <Header active="en" langLinks={{ en: "en/story/", de: "de/story/" }} />

  <main class="container">
    <section class="section hero">
      <div class="kicker">Innovation × Technology × Entrepreneurship</div>
      <h1>My story</h1>
      <p>
        I build future ready products and organizations, where engineering, management, and entrepreneurial thinking meet.
      </p>

      <div class="pull">
        <div class="pullHeading">Guiding principle</div>
        <div class="pullQuote">There is nothing so useless as doing efficiently that which should not be done at all.</div>
        <div class="pullAuthor">Peter F. Drucker</div>
      </div>

      <div class="ctaRow" style="margin-top:18px;">
        <a class="btn btnPrimary" href={href("en/#contact")}>Contact</a>
        <a class="btn" href={href("en/")}>Back to profile</a>
      </div>
    </section>

    <section class="section story">
      {chapters.map(c => (
        <section class="chapter" id={c.id}>
          <div class="chapterHeader">
            <h2>{c.title}</h2>
            {c.location ? (
              <div class="chapterLocation">
                <a href={c.location.href} target="_blank" rel="noopener">{c.location.label}</a>
              </div>
            ) : null}
          </div>

          {c.body.map(p => <p>{p}</p>)}

          <ul class="milestones">
            {c.milestones.map(m => <li>{m}</li>)}
          </ul>

          {c.marks.length ? (
            <div class="chapterMarks" aria-label="Related organizations">
              {c.marks.map(key => (
                <img class={markClass(key)} loading="lazy" src={MARK[key].src} alt={MARK[key].alt} />
              ))}
            </div>
          ) : null}
        </section>
      ))}
    </section>
  </main>
</BaseLayout>
