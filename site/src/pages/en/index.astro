---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Header from "../../components/Header.astro";

const base = import.meta.env.BASE_URL;
const href = (p) => `${base}${p.replace(/^\//, "")}`;
---

<BaseLayout title="Kunal Gehlot - Innovation & Digital Transformation" lang="en">
  <Header active="en" />

  <main class="container">
    <section class="section hero">
      <div class="kicker">Innovation × Technology × Entrepreneurship</div>
      <div class="nameRow">
        <h1>Kunal Gehlot</h1>
        <a class="pronouns" href="https://pronouns.org" target="_blank" rel="noopener">he / his / him</a>
      </div>
      <p>
        MBA (Digitalization & Industrial Change) with a software and automation core, building logistics products, innovation
        governance, and data systems across Germany and India.
      </p>

      <div class="ctaRow">
        <a class="btn btnPrimary" href={href("en/story/")}>Read my story</a>
        <a class="btn" href="#contact">Contact</a>
      </div>

      <div class="highlights">
        <div class="highlight">
          <h3>Logistics software (EPG LFS)</h3>
          <p>Extending COBOL-based warehouse management capabilities for global logistics clients at Erhardt + Partner Group.</p>
        </div>
        <div class="highlight">
          <h3>Innovation governance at Generali</h3>
          <p>Built a master thesis operating model and KPI approach for a decentralized insurer; delivered network automation for EU data centers.</p>
        </div>
        <div class="highlight">
          <h3>Business model innovation for Infineon</h3>
          <p>Explored circular-economy models for returned power modules and delivered a strategy that earned an internal innovation award.</p>
        </div>
      </div>
    </section>

    <section class="section columns">
      <div>
        <h2 class="h2">Experience (summary)</h2>

        <div class="item">
          <div class="itemTitle">
            <strong>Junior Software Developer - Erhardt + Partner Group</strong>
            <span class="meta">Alzenau · Oct 2025-present</span>
          </div>
          <div class="meta">Extending COBOL-based warehouse management for logistics clients.</div>
        </div>

        <div class="item">
          <div class="itemTitle">
            <strong>Working Student - Generali</strong>
            <span class="meta">Aachen · Dec 2023-Jun 2025</span>
          </div>
          <div class="meta">Innovation governance thesis + network automation for EU data centers.</div>
        </div>

        <div class="item">
          <div class="itemTitle">
            <strong>Software Engineer - Health Vectors</strong>
            <span class="meta">May 2021-Aug 2023</span>
          </div>
          <div class="meta">Back-end and data pipelines for 100k+ medical reports per year.</div>
        </div>
      </div>

      <div>
        <h2 class="h2">Skills & tools</h2>

        <div class="item">
          <div class="itemTitle"><strong>Technical</strong></div>
          <div class="meta">Python, COBOL, SQL, Docker, Node.js, Terraform, ML/AI, 3D printing</div>
        </div>

        <div class="item">
          <div class="itemTitle"><strong>Innovation & delivery</strong></div>
          <div class="meta">Innovation governance, business model innovation, design thinking, agile projects, process optimization</div>
        </div>

        <div class="item">
          <div class="itemTitle"><strong>Leadership</strong></div>
          <div class="meta">Stakeholder engagement, cross-functional facilitation, strategic decision-making</div>
        </div>

        <div class="item">
          <div class="itemTitle"><strong>Languages</strong></div>
          <div class="meta">English (C2), German (C1), Hindi (C2)</div>
        </div>

        <div class="item">
          <div class="itemTitle"><strong>Technologies</strong></div>
          <div class="meta">Programmiersprachen: Python, C/C++, HTML, CSS, JavaScript</div>
          <div class="meta">Frameworks/Tools: Flask, Django, FastAPI, Node.js, Terraform, Ansible, Robot</div>
          <div class="meta">Datenbanken: MongoDB, Tableau, PostgreSQL, MySQL</div>
          <div class="meta">Entwicklungsumgebung: Microsoft Visual Studio Code</div>
          <div class="meta">Machine Learning: Tensorflow, Keras, Scikit-learn, PyTorch</div>
          <div class="meta">Sonstiges: Docker, Git, GitHub, GitLab, Jira, PyTest, Bash, Office, Azure, Machine Learning, Streamlit, IoT (Arduino & Raspberry Pi), Swagger, ReDoc</div>
        </div>

        <h2 class="h2" style="margin-top:28px;">Education</h2>

        <div class="item">
          <div class="itemTitle">
            <strong>MBA - RWTH Aachen</strong>
            <span class="meta">2023-2025</span>
          </div>
          <div class="meta">Digitalization & Industrial Change</div>
        </div>

        <div class="item">
          <div class="itemTitle">
            <strong>B.Tech - Computer Science</strong>
            <span class="meta">2017-2021</span>
          </div>
          <div class="meta">
            <a class="inlineLink" href={href("cv/zab.pdf")} target="_blank" rel="noopener">ZAB verification (PDF)</a> · Confirms degree validity in Germany.
          </div>
        </div>
      </div>
    </section>

    <section class="section" id="books">
      <div class="cvTop">
        <div>
          <h2 class="h2" style="margin:0;">Books I recommend</h2>
          <div class="meta">
            Frameworks I’ve used for innovation, product thinking, and business models.
            <a class="navLink" href="https://www.goodreads.com/user/show/186180596-kunal-gehlot" target="_blank" rel="noopener"
              >Goodreads</a
            >
          </div>
        </div>
        <div>
          <a class="btn" href="https://www.goodreads.com/user/show/186180596-kunal-gehlot" target="_blank" rel="noopener">Goodreads</a>
        </div>
      </div>

      <div class="booksGrid">
        <a class="book" href="https://www.goodreads.com/book/show/57338463-the-corporate-startup" target="_blank" rel="noopener" style="--book-bg:#d6dfe2;">
          <img
            class="bookCover"
            src={href("img/books/corporate-startup.jpg")}
            alt="The Corporate Startup cover"
            loading="lazy"
          />
          <div class="bookTitle">The Corporate Startup</div>
          <div class="bookMeta">Tendayi Viki, Dan Toma, Esther Gons · Venture building</div>
          <div class="bookNote">Playbook for running venture portfolios inside enterprises with clear governance and metrics.</div>
        </a>

        <a class="book" href="https://www.goodreads.com/book/show/22776635-the-business-model-navigator" target="_blank" rel="noopener" style="--book-bg:#858581;">
          <img
            class="bookCover"
            src={href("img/books/business-model-navigator.jpg")}
            alt="The Business Model Navigator cover"
            loading="lazy"
          />
          <div class="bookTitle">The Business Model Navigator</div>
          <div class="bookMeta">Gassmann et al. · Business model patterns</div>
          <div class="bookNote">50+ patterns that quickly reframe value creation and capture for new offers.</div>
        </a>

        <a class="book" href="https://www.goodreads.com/book/show/10127019-the-lean-startup" target="_blank" rel="noopener" style="--book-bg:#8ab5d4;">
          <img
            class="bookCover"
            src={href("img/books/lean-startup.jpg")}
            alt="The Lean Startup cover"
            loading="lazy"
          />
          <div class="bookTitle">The Lean Startup</div>
          <div class="bookMeta">Eric Ries · Experimentation & iteration</div>
          <div class="bookNote">Systematically tests assumptions early so the right product emerges before scaling.</div>
        </a>

        <a class="book" href="https://www.goodreads.com/book/show/25814544-sprint" target="_blank" rel="noopener" style="--book-bg:#77d2d9;">
          <img
            class="bookCover"
            src={href("img/books/sprint.jpg")}
            alt="Sprint cover"
            loading="lazy"
          />
          <div class="bookTitle">Sprint</div>
          <div class="bookMeta">Jake Knapp · Rapid problem-solving</div>
          <div class="bookNote">A crisp five-day loop to align a team and test a risky idea with users fast.</div>
        </a>
      </div>
    </section>

    <section class="section">
      <div class="cvTop">
        <div>
          <h2 class="h2" style="margin:0;">Curriculum Vitae</h2>
          <div class="meta">Full details in PDF</div>
        </div>

        <div style="display:flex; gap:10px; flex-wrap:wrap;">
          <a class="btn" href={href("cv/cv-en.pdf")} target="_blank" rel="noopener">Open in new tab</a>
          <a class="btn btnPrimary" href={href("cv/cv-en.pdf")} download>Download</a>
        </div>
      </div>

      <div class="cvFrame">
        <iframe src={`${base}cv/cv-en.pdf`} title="CV PDF"></iframe>
      </div>
    </section>

    <section class="section" id="contact">
      <h2 class="h2">Contact</h2>
      <div class="meta">Best ways to reach me.</div>
      <div class="meta">Goethestraße 96, Offenbach 63067</div>

      <div class="contactRow">
        <a class="btn btnPrimary" href="tel:+491631838202">Call</a>
        <a class="btn" href="https://wa.me/491631838202" target="_blank" rel="noopener">WhatsApp</a>
        <a class="btn" href="mailto:kunal.gehlot@rwth-aachen.de">Email</a>
        <a class="btn" href="https://linkedin.com/in/gehlotk" target="_blank" rel="noopener">Message on LinkedIn</a>
      </div>
    </section>
  </main>

  <footer>
    <div class="container">
      © {new Date().getFullYear()} Kunal Gehlot · <a class="navLink" href="/impressum/">Impressum</a> · <a class="navLink" href="/datenschutz/">Datenschutz</a>
    </div>
  </footer>
</BaseLayout>
