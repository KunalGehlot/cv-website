---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Header from "../../components/Header.astro";
---

<BaseLayout title="Kunal Gehlot - Innovation & Digital Transformation" lang="en">
  <Header active="en" />

  <main class="container">
    <section class="section hero">
      <div class="kicker">Innovation × Technology × Entrepreneurship</div>
      <h1>Kunal Gehlot</h1>
      <p>
        I build future ready products and organizations, where engineering, management, and entrepreneurial thinking meet.
      </p>

      <div class="ctaRow">
        <a class="btn btnPrimary" href="/en/story/">Read my story</a>
        <a class="btn" href="#contact">Contact</a>
      </div>

      <div class="highlights">
        <div class="highlight">
          <h3>Thesis: Innovation Governance in MNCs</h3>
          <p>Built a governance framework with steering metrics to align decentralized innovation and funding, based on a Generali case study.</p>
        </div>
        <div class="highlight">
          <h3>Transformation & Automation</h3>
          <p>Led automation and process improvements that reduced manual steps and improved delivery reliability across teams.</p>
        </div>
        <div class="highlight">
          <h3>Data-driven Decision Making</h3>
          <p>Built data pipelines that turned messy medical reports into structured insights for decision support.</p>
        </div>
      </div>
    </section>

    <section class="section columns">
      <div>
        <h2 class="h2">Experience (summary)</h2>

        <div class="item">
          <div class="itemTitle">
            <strong>Working Student - Generali</strong>
            <span class="meta">Aachen · 2023-present</span>
          </div>
          <div class="meta">Innovation governance & automation support</div>
        </div>

        <div class="item">
          <div class="itemTitle">
            <strong>Back-end / Data Engineer - Health Vectors</strong>
            <span class="meta">2021-2023</span>
          </div>
          <div class="meta">Data pipelines, analytics, decision support</div>
        </div>

        <div class="item">
          <div class="itemTitle">
            <strong>Business Analyst - 3 Edge Technovision</strong>
            <span class="meta">Earlier</span>
          </div>
          <div class="meta">Business analysis & stakeholder coordination</div>
        </div>
      </div>

      <div>
        <h2 class="h2">Skills</h2>

        <div class="item">
          <div class="itemTitle"><strong>Consulting & Transformation</strong></div>
          <div class="meta">Stakeholders, requirements, KPI/OKR thinking</div>
        </div>

        <div class="item">
          <div class="itemTitle"><strong>Product / Project</strong></div>
          <div class="meta">Delivery support, prioritization, Agile</div>
        </div>

        <div class="item">
          <div class="itemTitle"><strong>Data & Automation</strong></div>
          <div class="meta">Python, SQL, automation, analytics</div>
        </div>

        <div class="item">
          <div class="itemTitle"><strong>Tools</strong></div>
          <div class="meta">Azure, Git, Docker, Tableau</div>
        </div>

        <h2 class="h2" style="margin-top:28px;">Education</h2>

        <div class="item">
          <div class="itemTitle">
            <strong>MBA - RWTH Aachen</strong>
            <span class="meta">2023-2025</span>
          </div>
          <div class="meta">Digitalization & Industrial Change</div>
        </div>

        <div class="item">
          <div class="itemTitle">
            <strong>B.Tech - Computer Science</strong>
            <span class="meta">2017-2021</span>
          </div>
        </div>
      </div>
    </section>

    <section class="section" id="books">
      <div class="cvTop">
        <div>
          <h2 class="h2" style="margin:0;">Books I recommend</h2>
          <div class="meta">
            Frameworks I’ve used for innovation, product thinking, and business models.
            <a class="navLink" href="https://www.goodreads.com/user/show/186180596-kunal-gehlot" target="_blank" rel="noopener"
              >Goodreads</a
            >
          </div>
        </div>
        <div>
          <a class="btn" href="https://www.goodreads.com/user/show/186180596-kunal-gehlot" target="_blank" rel="noopener">Goodreads</a>
        </div>
      </div>

      <div class="booksGrid">
        <a class="book" href="https://www.goodreads.com/book/show/25814544-sprint" target="_blank" rel="noopener">
          <img
            class="bookCover"
            src="https://covers.openlibrary.org/b/isbn/150112174X-L.jpg"
            alt="Sprint cover"
            loading="lazy"
          />
          <div class="bookTitle">Sprint</div>
          <div class="bookMeta">Jake Knapp · Rapid problem-solving</div>
          <div class="bookNote">Great for turning a fuzzy problem into a focused week and a tested direction.</div>
        </a>

        <a class="book" href="https://www.goodreads.com/book/show/10127019-the-lean-startup" target="_blank" rel="noopener">
          <img
            class="bookCover"
            src="https://covers.openlibrary.org/b/isbn/0307887898-L.jpg"
            alt="The Lean Startup cover"
            loading="lazy"
          />
          <div class="bookTitle">The Lean Startup</div>
          <div class="bookMeta">Eric Ries · Experimentation & iteration</div>
          <div class="bookNote">A reminder to test assumptions early and learn before scaling a solution.</div>
        </a>

        <a
          class="book"
          href="https://www.goodreads.com/book/show/22776635-the-business-model-navigator"
          target="_blank"
          rel="noopener"
        >
          <img
            class="bookCover"
            src="https://covers.openlibrary.org/b/isbn/1292065834-L.jpg"
            alt="The Business Model Navigator cover"
            loading="lazy"
          />
          <div class="bookTitle">The Business Model Navigator</div>
          <div class="bookMeta">Gassmann et al. · Business model patterns</div>
          <div class="bookNote">Useful patterns for reframing a business model when constraints are real.</div>
        </a>
      </div>
    </section>

    <section class="section">
      <div class="cvTop">
        <div>
          <h2 class="h2" style="margin:0;">Curriculum Vitae</h2>
          <div class="meta">Full details in PDF</div>
        </div>

        <div style="display:flex; gap:10px; flex-wrap:wrap;">
          <a class="btn" href="/cv/cv-en.pdf" target="_blank" rel="noopener">Open in new tab</a>
          <a class="btn btnPrimary" href="/cv/cv-en.pdf" download>Download</a>
        </div>
      </div>

      <div class="cvFrame">
        <iframe src="/cv/cv-en.pdf" title="CV PDF"></iframe>
      </div>
    </section>

    <section class="section" id="contact">
      <h2 class="h2">Contact</h2>
      <div class="meta">Best ways to reach me.</div>

      <div class="contactRow">
        <a class="btn btnPrimary" href="tel:+491631838202">Call</a>
        <a class="btn" href="https://wa.me/491631838202" target="_blank" rel="noopener">WhatsApp</a>
        <a class="btn" href="mailto:kunal.gehlot@rwth-aachen.de">Email</a>
        <a class="btn" href="https://linkedin.com/in/gehlotk" target="_blank" rel="noopener">Message on LinkedIn</a>
      </div>
    </section>
  </main>

  <footer>
    <div class="container">
      © {new Date().getFullYear()} Kunal Gehlot · <a class="navLink" href="/impressum/">Impressum</a> · <a class="navLink" href="/datenschutz/">Datenschutz</a>
    </div>
  </footer>
</BaseLayout>
