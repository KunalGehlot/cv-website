---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Header from "../../components/Header.astro";
---

<BaseLayout title="Kunal Gehlot — Innovation & Digital Transformation" lang="en">
  <Header active="en" />

  <main class="container">
    <section class="hero">
      <h1>Kunal Gehlot</h1>
      <p>
        <strong>Innovation & Digital Transformation</strong> · Product / Project Management · Data-driven
        Consulting
      </p>
      <p>
        I bridge business and technology to deliver measurable transformation—automation, analytics, and innovation
        governance in large organizations.
      </p>

      <div class="cta-row">
        <a class="button primary" href="/cv/cv-en.pdf" target="_blank" rel="noopener">Download CV (PDF)</a>
        <a class="button" href="mailto:kunal.gehlot@rwth-aachen.de">Contact</a>
      </div>
    </section>

    <section class="grid-3">
      <div class="card">
        <h3>Thesis: Innovation Governance in MNCs</h3>
        <p>Governance approach + performance metrics for innovation steering (case study: Generali).</p>
      </div>
      <div class="card">
        <h3>Transformation & Automation</h3>
        <p>Automation initiatives supporting digital transformation and operational efficiency.</p>
      </div>
      <div class="card">
        <h3>Analytics for Decisions</h3>
        <p>Data engineering + analytics to improve decision quality and outcomes.</p>
      </div>
    </section>

    <section class="section kv">
      <div>
        <h2>Experience (summary)</h2>
        <div class="list">
          <div class="item">
            <div><strong>Working Student — Generali</strong></div>
            <div class="meta">Aachen · 2023–present</div>
            <div class="meta">Innovation governance & automation support</div>
          </div>
          <div class="item">
            <div><strong>Back-end / Data Engineer — Health Vectors</strong></div>
            <div class="meta">2021–2023</div>
            <div class="meta">Data pipelines, analytics, decision support</div>
          </div>
          <div class="item">
            <div><strong>Business Analyst — 3 Edge Technovision</strong></div>
            <div class="meta">Earlier</div>
            <div class="meta">Business analysis & stakeholder coordination</div>
          </div>
        </div>
      </div>

      <div>
        <h2>Skills</h2>
        <div class="list">
          <div class="item">
            <strong>Consulting & Transformation</strong><div class="meta">Stakeholders, requirements, KPI/OKR thinking</div>
          </div>
          <div class="item"><strong>Product / Project</strong><div class="meta">Delivery support, prioritization, Agile basics</div></div>
          <div class="item"><strong>Data & Automation</strong><div class="meta">Python, SQL, automation, analytics</div></div>
          <div class="item"><strong>Tools</strong><div class="meta">Azure, Git, Docker, Tableau</div></div>
        </div>

        <div class="section">
          <h2>Education</h2>
          <div class="list">
            <div class="item"><strong>MBA — Digitalization & Industrial Change (RWTH Aachen)</strong><div class="meta">2023–2025</div></div>
            <div class="item"><strong>B.Tech — Computer Science</strong><div class="meta">2017–2021</div></div>
          </div>
        </div>
      </div>
    </section>

    <section class="section">
      <h2>Curriculum Vitae (PDF)</h2>
      <p>
        <a href="/cv/cv-en.pdf" target="_blank" rel="noopener">Open in new tab</a> ·
        <a href="/cv/cv-en.pdf" download>Download</a>
      </p>

      <div class="pdfbox">
        <iframe src="/cv/cv-en.pdf" title="CV PDF"></iframe>
      </div>
    </section>
  </main>

  <footer>
    <div class="container">
      <div>
        © {new Date().getFullYear()} Kunal Gehlot · <a href="/impressum/">Impressum</a> ·
        <a href="/datenschutz/">Datenschutz</a>
      </div>
    </div>
  </footer>
</BaseLayout>
