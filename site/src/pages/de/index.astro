---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Header from "../../components/Header.astro";

const base = import.meta.env.BASE_URL;
const href = (p) => `${base}${p.replace(/^\//, "")}`;
---

<BaseLayout title="Kunal Gehlot - Innovation & Digitale Transformation" lang="de">
  <Header active="de" />

  <main class="container">
    <section class="section hero">
      <div class="kicker">Innovation × Technologie × Unternehmertum</div>
      <div class="nameRow">
        <h1>Kunal Gehlot</h1>
        <a class="pronouns" href="https://pronouns.org" target="_blank" rel="noopener">he / his / him</a>
      </div>
      <p>
        MBA (Digitalization & Industrial Change) mit technischem Schwerpunkt auf Software und Automatisierung, baue
        Logistiksoftware, Innovations-Governance und Datensysteme in Deutschland und Indien.
      </p>

      <div class="ctaRow">
        <a class="btn btnPrimary" href={href("de/story/")}>Story</a>
        <a class="btn" href="#contact">Kontakt</a>
      </div>

      <div class="highlights">
        <div class="highlight">
          <h3>Logistiksoftware (EPG LFS)</h3>
          <p>COBOL-basierte Warehouse-Management-Funktionen für globale Logistikkunden bei Erhardt + Partner Group weiterentwickelt.</p>
        </div>
        <div class="highlight">
          <h3>Innovations-Governance bei Generali</h3>
          <p>Masterarbeit zu Operating Model und KPI-Ansatz für einen dezentralen Versicherer; Network Automation für EU Rechenzentren geliefert.</p>
        </div>
        <div class="highlight">
          <h3>Business Model Innovation für Infineon</h3>
          <p>Zirkulare Geschäftsmodelle für zurückgeführte Powermodule entwickelt und eine Strategie geliefert, die einen internen Innovationspreis erhielt.</p>
        </div>
      </div>
    </section>

    <section class="section columns">
      <div>
        <h2 class="h2">Erfahrung (Kurz)</h2>

        <div class="item">
          <div class="itemTitle">
            <strong>Junior Software Developer - EPG</strong>
            <span class="meta">Alzenau · Okt 2025-heute</span>
          </div>
          <div class="meta">COBOL-basierte Warehouse-Management-Features für Logistikkunden.</div>
        </div>

        <div class="item">
          <div class="itemTitle">
            <strong>Werkstudent - Generali</strong>
            <span class="meta">Aachen · Dez 2023-Jun 2025</span>
          </div>
          <div class="meta">Innovations-Governance (MBA Thesis) und Network Automation für EU Rechenzentren.</div>
        </div>

        <div class="item">
          <div class="itemTitle">
            <strong>Software Engineer - Health Vectors</strong>
            <span class="meta">Mai 2021-Aug 2023</span>
          </div>
          <div class="meta">Back-end und Datenpipelines für 100k+ medizinische Datensätze pro Jahr.</div>
        </div>
      </div>

      <div>
        <h2 class="h2">Skills & Tools</h2>

        <div class="item">
          <div class="itemTitle"><strong>Technisch</strong></div>
          <div class="meta">Python, COBOL, SQL, Docker, Node.js, Terraform, ML/AI, 3D Printing</div>
        </div>

        <div class="item">
          <div class="itemTitle"><strong>Innovation & Umsetzung</strong></div>
          <div class="meta">Innovation Governance, Business Model Innovation, Design Thinking, agile Projekte, Prozessoptimierung</div>
        </div>

        <div class="item">
          <div class="itemTitle"><strong>Führung & Zusammenarbeit</strong></div>
          <div class="meta">Stakeholder-Management, Cross-Functional Facilitation, strategische Entscheidungen</div>
        </div>

        <div class="item">
          <div class="itemTitle"><strong>Sprachen</strong></div>
          <div class="meta">Englisch (C2), Deutsch (C1), Hindi (C2)</div>
        </div>

        <div class="item">
          <div class="itemTitle"><strong>Technologien</strong></div>
          <div class="meta">Programmiersprachen: Python, C/C++, HTML, CSS, JavaScript</div>
          <div class="meta">Frameworks/Tools: Flask, Django, FastAPI, Node.js, Terraform, Ansible, Robot</div>
          <div class="meta">Datenbanken: MongoDB, Tableau, PostgreSQL, MySQL</div>
          <div class="meta">Entwicklungsumgebung: Microsoft Visual Studio Code</div>
          <div class="meta">Machine Learning: Tensorflow, Keras, Scikit-learn, PyTorch</div>
          <div class="meta">Sonstiges: Docker, Git, GitHub, GitLab, Jira, PyTest, Bash, Office, Azure, Machine Learning, Streamlit, IoT (Arduino & Raspberry Pi), Swagger, ReDoc</div>
        </div>

        <h2 class="h2" style="margin-top:28px;">Ausbildung</h2>

        <div class="item">
          <div class="itemTitle">
            <strong>MBA - RWTH Aachen</strong>
            <span class="meta">2023-2025</span>
          </div>
          <div class="meta">Digitalization & Industrial Change</div>
        </div>

        <div class="item">
          <div class="itemTitle">
            <strong>B.Tech - Informatik</strong>
            <span class="meta">2017-2021</span>
          </div>
          <div class="meta">
            <a class="inlineLink" href={href("cv/zab.pdf")} target="_blank" rel="noopener">ZAB-Anerkennung (PDF)</a> · Bestätigung der Gleichwertigkeit in Deutschland.
          </div>
        </div>
      </div>
    </section>

    <section class="section" id="books">
      <div class="cvTop">
        <div>
          <h2 class="h2" style="margin:0;">Bücher, die ich empfehle</h2>
          <div class="meta">
            Frameworks, auf die ich für Innovation, Product Thinking und Geschäftsmodelle setze.
            <a class="navLink" href="https://www.goodreads.com/user/show/186180596-kunal-gehlot" target="_blank" rel="noopener"
              >Goodreads</a
            >
          </div>
        </div>
        <div>
          <a class="btn" href="https://www.goodreads.com/user/show/186180596-kunal-gehlot" target="_blank" rel="noopener">Goodreads</a>
        </div>
      </div>

      <div class="booksGrid">
        <a class="book" href="https://www.goodreads.com/book/show/57338463-the-corporate-startup" target="_blank" rel="noopener" style="--book-bg:#d6dfe2;">
          <img
            class="bookCover"
            src={href("img/books/corporate-startup.jpg")}
            alt="The Corporate Startup cover"
            loading="lazy"
          />
          <div class="bookTitle">The Corporate Startup</div>
          <div class="bookMeta">Viki et al. · Corporate Venture Building</div>
          <div class="bookNote">Struktur für Venture-Portfolios im Konzern mit klarer Governance und messbaren KPIs.</div>
        </a>

        <a class="book" href="https://www.goodreads.com/book/show/22776635-the-business-model-navigator" target="_blank" rel="noopener" style="--book-bg:#858581;">
          <img
            class="bookCover"
            src={href("img/books/business-model-navigator.jpg")}
            alt="The Business Model Navigator cover"
            loading="lazy"
          />
          <div class="bookTitle">The Business Model Navigator</div>
          <div class="bookMeta">Gassmann et al. · Business Model Patterns</div>
          <div class="bookNote">50+ Muster, die neue Wege für Wertschöpfung und Erlöse aufzeigen.</div>
        </a>

        <a class="book" href="https://www.goodreads.com/book/show/10127019-the-lean-startup" target="_blank" rel="noopener" style="--book-bg:#8ab5d4;">
          <img
            class="bookCover"
            src={href("img/books/lean-startup.jpg")}
            alt="The Lean Startup cover"
            loading="lazy"
          />
          <div class="bookTitle">The Lean Startup</div>
          <div class="bookMeta">Eric Ries · Experimentation & Iteration</div>
          <div class="bookNote">Tests von Annahmen sehr früh, damit die richtige Lösung vor dem Skalieren entsteht.</div>
        </a>

        <a class="book" href="https://www.goodreads.com/book/show/25814544-sprint" target="_blank" rel="noopener" style="--book-bg:#77d2d9;">
          <img
            class="bookCover"
            src={href("img/books/sprint.jpg")}
            alt="Sprint cover"
            loading="lazy"
          />
          <div class="bookTitle">Sprint</div>
          <div class="bookMeta">Jake Knapp · Rapid Problem-Solving</div>
          <div class="bookNote">Eine fokussierte 5-Tage-Schleife, um ein Risiko-Thema schnell mit Nutzern zu testen.</div>
        </a>
      </div>
    </section>

    <section class="section">
      <div class="cvTop">
        <div>
          <h2 class="h2" style="margin:0;">Lebenslauf</h2>
          <div class="meta">Alle Details als PDF</div>
        </div>

        <div style="display:flex; gap:10px; flex-wrap:wrap;">
          <a class="btn" href={href("cv/cv-de.pdf")} target="_blank" rel="noopener">In neuem Tab öffnen</a>
          <a class="btn btnPrimary" href={href("cv/cv-de.pdf")} download>Herunterladen</a>
        </div>
      </div>

      <div class="cvFrame">
        <iframe src={`${base}cv/cv-de.pdf`} title="CV PDF"></iframe>
      </div>
    </section>

    <section class="section" id="contact">
      <h2 class="h2">Kontakt</h2>
      <div class="meta">Beste Wege, mich zu erreichen.</div>
      <div class="meta">Goethestraße 96, Offenbach 63067</div>

      <div class="contactRow">
        <a class="btn btnPrimary" href="tel:+491631838202">Anrufen</a>
        <a class="btn" href="https://wa.me/491631838202" target="_blank" rel="noopener">WhatsApp</a>
        <a class="btn" href="mailto:kunal.gehlot@rwth-aachen.de">E-Mail</a>
        <a class="btn" href="https://linkedin.com/in/gehlotk" target="_blank" rel="noopener">Nachricht auf LinkedIn</a>
      </div>
    </section>
  </main>

  <footer>
    <div class="container">
      © {new Date().getFullYear()} Kunal Gehlot · <a class="navLink" href="/impressum/">Impressum</a> · <a class="navLink" href="/datenschutz/">Datenschutz</a>
    </div>
  </footer>
</BaseLayout>
