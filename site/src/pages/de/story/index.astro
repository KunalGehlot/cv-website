---

<BaseLayout title="Meine Story, Kunal Gehlot" lang="de">
  <Header active="de" langLinks={{ en: "/en/story/", de: "/de/story/" }} />

  <main class="container">
    <section class="section hero">
      <div class="kicker">Innovation × Technologie × Unternehmertum</div>
      <h1>Meine Story</h1>
      <p>
        Ich gestalte zukunftsfähige Produkte und Organisationen, an der Schnittstelle von Engineering, Management und
        Unternehmertum.
      </p>

      <div class="pull">
        <strong>Leitgedanke</strong> There is nothing so useless as doing efficiently that which should not be done at all.
        <div style="margin-top:6px;">Peter F. Drucker</div>
      </div>

      <div class="ctaRow" style="margin-top:18px;">
        <a class="btn btnPrimary" href="/de/#contact">Kontakt</a>
        <a class="btn" href="/de/">Zurück</a>
      </div>
    </section>

    <section class="section story">
      <aside class="rail">
        <div class="railTitle">Kapitel</div>
        {chapters.map(c => (
          <a class="railLink" href={`#${c.id}`} data-rail={c.id}>
            <span class="railDot"></span>
            <span>{c.rail}</span>
          </a>
        ))}
      </aside>

      <div>
        {chapters.map(c => (
          <section class="chapter" id={c.id} data-chapter>
            <div class="chapterTop">
              <div>
                <div class="chapterKicker">{c.kicker}</div>
                <h2>{c.title}</h2>
              </div>
              <div class="marks" aria-label="Verknüpfte Organisationen">
                {c.marks.map(key => (
                  <img class="mark" loading="lazy" src={MARK[key].src} alt={MARK[key].alt} />
                ))}
              </div>
            </div>

            {c.body.map(p => <p>{p}</p>)}

            <ul class="milestones">
              {c.milestones.map(m => <li>{m}</li>)}
            </ul>
          </section>
        ))}
      </div>
    </section>
  </main>

  <script>
    const sections = Array.from(document.querySelectorAll("[data-chapter]"))
    const railLinks = Array.from(document.querySelectorAll("[data-rail]"))

    const setActive = (id) => {
      railLinks.forEach(a => a.classList.toggle("active", a.getAttribute("data-rail") === id))
    }

    const observer = new IntersectionObserver((entries) => {
      const visible = entries
        .filter(e => e.isIntersecting)
        .sort((a,b) => b.intersectionRatio - a.intersectionRatio)[0]
      if (visible) setActive(visible.target.id)
    }, { rootMargin: "-30% 0px -60% 0px", threshold: [0.2, 0.35, 0.5, 0.65] })

    sections.forEach(s => observer.observe(s))
    if (sections[0]) setActive(sections[0].id)
  </script>
</BaseLayout>
