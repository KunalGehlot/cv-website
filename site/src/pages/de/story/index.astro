---
import BaseLayout from "../../../layouts/BaseLayout.astro"
import Header from "../../../components/Header.astro"

const MARK = {
  gdev: { alt: "Google Developers", src: "https://commons.wikimedia.org/wiki/Special:FilePath/Google%20Developers%20logo.svg" },
  msft: { alt: "Microsoft", src: "https://commons.wikimedia.org/wiki/Special:FilePath/Microsoft%20logo%20(2012).svg" },
  upwork: { alt: "Upwork", src: "https://commons.wikimedia.org/wiki/Special:FilePath/Upwork-Logo-Black.svg" },
  healthvectors: { alt: "Health Vectors", src: "/logos/healthvectors.svg" },
  rwth: { alt: "RWTH Aachen", src: "https://commons.wikimedia.org/wiki/Special:FilePath/RWTH%20Logo%203.svg" },
  infineon: { alt: "Infineon", src: "https://commons.wikimedia.org/wiki/Special:FilePath/Infineon-Logo.svg" },
  generali: { alt: "Generali", src: "https://commons.wikimedia.org/wiki/Special:FilePath/Generali%20wordmark%20logo.svg" },
  epg: { alt: "EPG", src: "https://commons.wikimedia.org/wiki/Special:FilePath/Logo%20der%20Ehrhardt%20Partner%20Group.svg" },
}

const chapters = [
  {
    id: "start",
    kicker: "Indien und eine Informatik Grundlage mit Community Arbeit",
    title: "Wo es begann",
    marks: ["gdev", "msft"],
    body: [
      "Ich bin Kunal. Mich treiben Innovation, Digitalisierung und IT Management, das Organisationen spürbar verändert.",
      "Meine Reise begann in Indien im Bachelor in Computer Science Engineering. Ich habe nicht nur studiert. Ich habe Communities aufgebaut, Menschen zusammengebracht, Lernziele gesetzt und die Energie hochgehalten.",
      "Diese Phase hat mich geprägt. Ich lerne schnell, baue Systeme und mag es, wenn Menschen wachsen, sobald der Rahmen passt."
    ],
    milestones: [
      "Bachelor in Computer Science Engineering",
      "Führung über studentische Communities und Events",
      "Große Hackathons, darunter einer mit mehr als 400 Teilnehmenden"
    ],
  },
  {
    id: "entrepreneurship",
    kicker: "Freelancing, Software Services, Kundenarbeit",
    title: "Erste Schritte im Unternehmertum",
    marks: ["upwork"],
    body: [
      "Parallel wollte ich etwas Eigenes aufbauen. Ich habe freiberuflich gearbeitet und Software Services geliefert.",
      "Es ging nicht nur um Code. Ich lernte Kundenführung, Requirement Management und Projektsteuerung in der Praxis.",
      "Die Zusammenarbeit mit einer Agentur brachte mich früh in Produkt und Projektdenken."
    ],
    milestones: [
      "Freelancing und Software Services",
      "Kundenkommunikation und Projektdelivery",
      "Produkt und Projekt Exposure durch Agenturarbeit"
    ],
  },
  {
    id: "health",
    kicker: "Health Vectors, Data Science Engineering",
    title: "Health Tech und Datenarbeit",
    marks: ["healthvectors"],
    body: [
      "Nach dem Abschluss startete ich bei Health Vectors in Bangalore als Software Engineer im Bereich Data Science.",
      "Ich baute Systeme, die unstrukturierte medizinische Berichte in klare Insights und verlässliche Workflows übersetzen.",
      "Wir entwickelten ein Health Scoring System für bessere Underwriting Entscheidungen und arbeiteten mit Partnern wie Munich Re und Allianz."
    ],
    milestones: [
      "Software Engineer Data Science bei Health Vectors",
      "Daten Workflows rund um medizinische Berichte und Decision Support",
      "Health Scoring System für Underwriting Use Cases"
    ],
  },
  {
    id: "chatgpt",
    kicker: "ChatGPT hat meinen Blick verändert",
    title: "Als AI den Blick verschob",
    marks: [],
    body: [
      "Als GPT 3.5 auf den Markt kam, änderte sich mein Blick auf das, was Teams liefern können.",
      "Ich fokussierte stärker auf Innovation, Digitalisierung und darauf, wie Organisationen schneller werden, ohne Chaos zu erzeugen.",
      "Ab da war Management für mich genauso spannend wie Engineering."
    ],
    milestones: [
      "Fokuswechsel hin zu Innovation und Digitalisierung",
      "Mehr Interesse an Prozess, Projekt und IT Management",
      "Klare Ausrichtung auf Business und Transformation"
    ],
  },
  {
    id: "germany",
    kicker: "Deutsch lernen und RWTH Aachen",
    title: "Deutschland als nächster Schritt",
    marks: ["rwth"],
    body: [
      "Ich lernte 2,5 Jahre Deutsch neben der Arbeit, weil ich in Deutschland studieren wollte.",
      "Schließlich ging ich an die RWTH Aachen für den MBA in Digitalization and Industrial Change.",
      "Das Entrepreneurial Mindset Scholarship bestätigte den Weg."
    ],
    milestones: [
      "2,5 Jahre Deutschlernen neben der Arbeit",
      "MBA an der RWTH Aachen in Digitalization and Industrial Change",
      "Entrepreneurial Mindset Scholarship"
    ],
  },
  {
    id: "mba",
    kicker: "Strategie, Innovation und Industrie",
    title: "MBA, aber praktisch",
    marks: ["rwth"],
    body: [
      "An der RWTH vertiefte ich Strategisches Management, Leading Innovation und Strategy Labs mit Industriebezug.",
      "Der Fokus lag auf Umsetzung, nicht nur auf Ideen. Wir mappten Customer Journeys, testeten Lösungen und bauten Go to Market Pfade.",
      "Unser Team erreichte die Bestnote 1,0."
    ],
    milestones: [
      "Fokus auf Strategisches Management und Leading Innovation",
      "Strategy Labs mit Industrieeinbindung",
      "Top Note durch intensive Teamarbeit"
    ],
  },
  {
    id: "capstone",
    kicker: "Infineon und das Abschlusssemester",
    title: "Capstone und Thesis",
    marks: ["infineon"],
    body: [
      "Das Abschlusssemester drehte sich um ein Capstone mit Infineon und meine Masterarbeit.",
      "Wir arbeiteten an nachhaltiger Innovation und Business Model Design für Circular Economy Herausforderungen.",
      "Das Projekt erhielt einen internen Innovationspreis bei der Präsentation im Unternehmen."
    ],
    milestones: [
      "Capstone Projekt mit Infineon",
      "Innovationspreis für die Teampräsentation",
      "Klarer Outcome Fokus und Top Noten"
    ],
  },
  {
    id: "generali",
    kicker: "Network Automation und Konzernrealität",
    title: "Innovation im Konzern verstehen",
    marks: ["generali"],
    body: [
      "Während des Masters arbeitete ich Teilzeit als Network Automation Engineer bei Assicurazioni Generali.",
      "Ich sah, wie Innovation in großen Organisationen funktioniert und warum Governance wichtig ist, wenn Innovation skalieren soll.",
      "Diese Erfahrung prägte meine Masterarbeit und machte das Thema praktisch."
    ],
    milestones: [
      "Network Automation in einem Enterprise Umfeld",
      "Direkte Einblicke in Innovationshürden auf Konzernebene",
      "Masterarbeit geprägt durch reale Governance Themen"
    ],
  },
  {
    id: "now",
    kicker: "EPG und der nächste Schritt",
    title: "Wo ich jetzt stehe",
    marks: ["epg"],
    body: [
      "Nach dem Abschluss startete ich bei EPG als Junior Software Developer.",
      "Ich baue meine Karriere in Deutschland auf und lerne, wie deutsche Organisationen von innen funktionieren.",
      "Ich ziele auf Rollen im Consulting, Produkt oder Projektmanagement, wo Tech und Business zusammenkommen."
    ],
    milestones: [
      "Junior Software Developer bei EPG",
      "Lernen, wie deutsche Organisationen arbeiten",
      "Zielrollen in Consulting, Produkt oder Projektmanagement"
    ],
  },
]
---

<BaseLayout title="Meine Story, Kunal Gehlot" lang="de">
  <Header active="de" langLinks={{ en: "/en/story/", de: "/de/story/" }} />

  <main class="container">
    <section class="section hero">
      <div class="kicker">Innovation × Technologie × Unternehmertum</div>
      <h1>Meine Story</h1>
      <p>
        Ich gestalte zukunftsfähige Produkte und Organisationen, an der Schnittstelle von Engineering, Management und
        Unternehmertum.
      </p>

      <div class="pull">
        <div class="pullHeading">Leitgedanke</div>
        <div class="pullQuote">There is nothing so useless as doing efficiently that which should not be done at all.</div>
        <div class="pullAuthor">Peter F. Drucker</div>
      </div>

      <div class="ctaRow" style="margin-top:18px;">
        <a class="btn btnPrimary" href="/de/#contact">Kontakt</a>
        <a class="btn" href="/de/">Zurück zum Profil</a>
      </div>
    </section>

    <section class="section story">
      {chapters.map(c => (
        <section class="chapter" id={c.id}>
          <div class="chapterHeader">
            <div class="chapterKicker">{c.kicker}</div>
            <h2>{c.title}</h2>
          </div>

          {c.body.map(p => <p>{p}</p>)}

          <ul class="milestones">
            {c.milestones.map(m => <li>{m}</li>)}
          </ul>

          {c.marks.length ? (
            <div class="chapterMarks" aria-label="Verknüpfte Organisationen">
              {c.marks.map(key => (
                <img class="mark" loading="lazy" src={MARK[key].src} alt={MARK[key].alt} />
              ))}
            </div>
          ) : null}
        </section>
      ))}
    </section>
  </main>
</BaseLayout>
