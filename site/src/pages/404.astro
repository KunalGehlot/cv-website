---
// GitHub Pages serves this for any missing page. Nobody knows the visitor's language here, so it
// speaks both.
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

const base = import.meta.env.BASE_URL;
---

<BaseLayout title="Wrong note, Kunal Gehlot" lang="en" description="This page doesn't exist.">
  <Header lang="en" />
  <main id="main" class="wrap missing">
    <div class="bar" aria-hidden="true">
      <span style="--x:0.04; --w:0.16; --r:2" data-track="eng"></span>
      <span style="--x:0.24; --w:0.12; --r:1" data-track="lead"></span>
      <span style="--x:0.4; --w:0.2; --r:0" data-track="lead"></span>
      <span class="off" style="--x:0.64; --w:0.1; --r:3"></span>
      <span style="--x:0.78; --w:0.18; --r:2" data-track="eng"></span>
    </div>
    <h1>Wrong note.</h1>
    <p>This page doesn’t exist. Start again from <a href={`${base}en/`}>the home page</a> or read <a href={`${base}en/story/`}>my story</a>.</p>
    <div lang="de">
      <h2>Falsche Note.</h2>
      <p>Diese Seite gibt es nicht. Weiter geht es auf der <a href={`${base}de/`}>Startseite</a> oder in <a href={`${base}de/story/`}>meiner Story</a>.</p>
    </div>
  </main>
  <Footer lang="en" />
</BaseLayout>

<style>
  .missing {
    padding-top: clamp(40px, 7vw, 96px);
  }
  /* A short phrase on the roll, with one note where no note belongs. */
  .bar {
    position: relative;
    height: 96px;
    max-width: 560px;
    margin-bottom: 40px;
    border-bottom: 1px solid var(--rule);
  }
  .bar span {
    position: absolute;
    left: calc(var(--x) * 100%);
    width: calc(var(--w) * 100%);
    top: calc(var(--r) * 22px + 6px);
    height: 16px;
    border-radius: 4px;
    background: var(--hand);
  }
  [data-track="eng"] {
    --hand: var(--hand-eng);
  }
  [data-track="lead"] {
    --hand: var(--hand-lead);
  }
  .bar .off {
    background: transparent;
    border: 2px dashed var(--slate);
    animation: wobble 1.6s ease-in-out infinite;
  }
  @keyframes wobble {
    50% {
      transform: translateY(-6px) rotate(-4deg);
    }
  }
  p {
    margin-top: 16px;
    font-size: 21px;
  }
  div[lang] {
    margin-top: 48px;
  }
</style>
