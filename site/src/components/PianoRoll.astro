  }
  .scrubbing .cursor {
    border-left: 1px solid var(--slate);
  }
  .scrubbing .cursor span {
    color: var(--slate);
  }
  .playing .playhead,
  .playing .vNow {
    visibility: hidden;
  }
  .note {
    left: calc(var(--x) * 100%);
    /* Back-to-back notes keep a hairline gap, like separately struck keys. */
    width: max(calc(var(--w) * 100% - 2px), 6px);
    top: calc(var(--headroom) + var(--row) * var(--pitch) + (var(--pitch) - var(--noteH)) / 2);
    height: var(--noteH);
