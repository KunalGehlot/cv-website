---
// The career piano roll: the site's signature. Layout is computed at build time (lib/roll.ts). The
// script plays it (a playhead draws the notes and strikes them on a small synthesised piano), lets
// a mouse scrub through time, and adds the popovers on hover and focus and the arrow keys.
import { formatMonth, formatRange, t, type Lang } from "../data/i18n";
import { H_AFTER, H_PLOT, V_LINE, firstYear, layoutRoll, type Note } from "../lib/roll";

interface Props {
  lang: Lang;
  /** Phones: the wide roll in a scrolling box (scroll), or notes falling toward "now" (vertical). */
  mobile?: "vertical" | "scroll";
}

const { lang, mobile = "scroll" } = Astro.props;
const roll = layoutRoll(lang);
const base = import.meta.env.BASE_URL;

const text = {
  en: {
    name: "My career, 2017 to today",
    lead: "Innovation and leadership",
    eng: "Engineering",
    now: "now",
    play: "Play",
    stop: "Stop",
    sound: "Sound",
    work: "Read the case study",
    story: "Read it in my story",
    list: "The same, as a list",
  },
  de: {
    name: "Mein Werdegang, 2017 bis heute",
    lead: "Innovation und Führung",
    eng: "Technik",
    now: "heute",
    play: "Abspielen",
    stop: "Stopp",
    sound: "Ton",
    work: "Zur Fallstudie",
    story: "Mehr in meiner Story",
    list: "Dasselbe als Liste",
  },
}[lang];

const trackName = (n: Note) => (n.track === "both" ? `${text.lead}, ${text.eng}` : text[n.track]);
const linkOf = (n: Note) => {
  const link = n.entry.link;
  if (!link) return undefined;
  return "work" in link
    ? { href: `${base}${lang}/work/${link.work}/`, text: text.work }
    : { href: `${base}${lang}/story/#${link.story}`, text: text.story };
};
const org = (n: Note) => [t(n.entry.org, lang), n.entry.place && t(n.entry.place, lang)].filter(Boolean).join(", ");
const dates = (n: Note) => formatRange(n.entry.start!, n.entry.end!, lang);

// Horizontal rows, top to bottom: leadership lanes (lane 0 nearest the middle), the middle row for
// notes that belong to both hands, then the engineering lanes.
const { lead, eng, both } = roll.lanes;
const row = (n: Note) => (n.track === "lead" ? lead - 1 - n.lane : n.track === "both" ? lead : lead + both + n.lane);
const rows = lead + both + eng;
const rowTrack = (r: number) => (r < lead ? "lead" : r < lead + both ? "both" : "eng");
// Black keys sit between the white ones as on a real keyboard, read from the top: B A G F E D C.
const blackBelow = (r: number) => r < rows - 1 && [1, 1, 1, 0, 1, 1, 0][r % 7] === 1;
const latest = roll.notes.reduce((a, b) => (b.x > a.x ? b : a));
const noteData = (n: Note) => ({ "data-x": n.x.toFixed(5), "data-w": n.w.toFixed(5), "data-row": row(n) });
---

<figure
  class="roll"
  data-mobile={mobile}
  data-first={firstYear}
  data-months={roll.months.toFixed(2)}
  data-rows={rows}
  data-now={text.now}
  aria-label={text.name}
  style={`--rows:${rows}; --lead:${lead}; --eng:${eng}; --p:1; --c:1`}
>
  <div class="transport">
    <button class="playBtn" type="button" data-play={text.play} data-stop={text.stop}>
      <svg class="iconPlay" viewBox="0 0 14 14" aria-hidden="true"><path d="M2 1l11 6-11 6z"></path></svg>
      <svg class="iconStop" viewBox="0 0 14 14" aria-hidden="true"><path d="M2 2h10v10H2z"></path></svg>
      <span>{text.play}</span>
    </button>
    <button class="soundBtn" type="button" aria-pressed="true" aria-label={text.sound}>
      <svg viewBox="0 0 20 20" aria-hidden="true">
        <path class="speaker" d="M3 7h3l5-4v14l-5-4H3z"></path>
        <path class="waves" d="M14 7a4 4 0 0 1 0 6M16 4.5a7.5 7.5 0 0 1 0 11"></path>
        <path class="mute" d="M14 7l5 6M19 7l-5 6"></path>
      </svg>
    </button>
    <p class="legend" aria-hidden="true">
      <span data-track="lead">{text.lead}</span>
      <span data-track="eng">{text.eng}</span>
    </p>
  </div>

  <div class="h" style={`--plot:${H_PLOT}px; --after:${H_AFTER}px`}>
    <div class="hInner">
      <span class="track" data-track="lead" style={`--top:0; --span:${lead}`}>{text.lead}</span>
      <span class="track" data-track="eng" style={`--top:${lead + both}; --span:${eng}`}>{text.eng}</span>
      <div class="keys" aria-hidden="true">
        {
          Array.from({ length: rows }, (_, r) => (
            <span class="key" data-row={r} data-track={rowTrack(r)} data-black={blackBelow(r) ? "" : undefined} />
          ))
        }
      </div>
      <div class="hPlot">
        {
          roll.years.map((y) => (
            <span class="year" style={`--x:${y.x}`}>
              <span>{y.year}</span>
            </span>
          ))
        }
        <span class="playhead"><span>{text.now}</span></span>
        <span class="cursor" aria-hidden="true"><span class="readout"></span></span>
        {
          roll.notes.map((n) => (
            <>
              <button
                class="note"
                type="button"
                data-order={n.order}
                data-track={n.track}
                data-label={n.hLabel}
                data-ongoing={n.ongoing ? "" : undefined}
                {...noteData(n)}
                tabindex={n === latest ? 0 : -1}
                popovertarget={`pop-h-${n.entry.id}`}
                style={`--x:${n.x}; --w:${n.w}; --row:${row(n)}`}
              >
                <span class="label">{t(n.entry.label, lang)}</span>
                <span class="sr-only">{`, ${t(n.entry.title, lang)}, ${dates(n)}`}</span>
              </button>
              <div class="pop" id={`pop-h-${n.entry.id}`} popover data-track={n.track}>
                <p class="popTitle">{t(n.entry.title, lang)}</p>
                <p class="popMeta">{org(n)}</p>
                <p class="popMeta">
                  {dates(n)} <span class="popTrack">{trackName(n)}</span>
                </p>
                <p>{t(n.entry.line, lang)}</p>
                {
                  n.entry.milestones && (
                    <ul class="popSteps">
                      {n.entry.milestones.map((m) => (
                        <li>
                          <span>{formatMonth(m.when, lang)}</span>
                          {m.link ? <a href={`${base}${lang}/work/${m.link.work}/`}>{t(m.text, lang)}</a> : t(m.text, lang)}
                        </li>
                      ))}
                    </ul>
                  )
                }
                {linkOf(n) && <a href={linkOf(n)!.href}>{linkOf(n)!.text}</a>}
              </div>
            </>
          ))
        }
      </div>
    </div>
  </div>

  <div class="v" style={`--vh:${roll.vHeight}px; --line:${V_LINE}px`}>
    <div class="vHead">
      <span data-track="eng">{text.eng}</span>
      <span data-track="lead">{text.lead}</span>
    </div>
    <div class="vPlot">
      {
        roll.years.map((y) => (
          <span class="vYear" style={`--y:${y.x}`}>
            <span>{y.year}</span>
          </span>
        ))
      }
      <span class="vNow"><span>{text.now}</span></span>
      <span class="vCursor" aria-hidden="true"><span class="readout"></span></span>
      {
        roll.notes.map((n) => (
          <>
            <button
              class="vNote"
              type="button"
              data-order={n.order}
              data-track={n.track}
              {...noteData(n)}
              tabindex={n === latest ? 0 : -1}
              popovertarget={`pop-v-${n.entry.id}`}
              style={`--y:${n.x}; --len:${n.w}; --lane:${n.lane}; --ly:${n.vLabelY}px; --lines:${n.vLines}`}
            >
              <span class="label">{t(n.entry.label, lang)}</span>
              <span class="sr-only">{`, ${t(n.entry.title, lang)}, ${dates(n)}`}</span>
            </button>
            <div class="pop" id={`pop-v-${n.entry.id}`} popover data-track={n.track}>
              <p class="popTitle">{t(n.entry.title, lang)}</p>
              <p class="popMeta">{org(n)}</p>
              <p class="popMeta">
                {dates(n)} <span class="popTrack">{trackName(n)}</span>
              </p>
              <p>{t(n.entry.line, lang)}</p>
              {
                n.entry.milestones && (
                  <ul class="popSteps">
                    {n.entry.milestones.map((m) => (
                      <li>
                        <span>{formatMonth(m.when, lang)}</span>
                        {m.link ? <a href={`${base}${lang}/work/${m.link.work}/`}>{t(m.text, lang)}</a> : t(m.text, lang)}
                      </li>
                    ))}
                  </ul>
                )
              }
              {linkOf(n) && <a href={linkOf(n)!.href}>{linkOf(n)!.text}</a>}
            </div>
          </>
        ))
      }
    </div>
  </div>

  <ol class="sr-only" aria-label={text.list}>
    {
      roll.notes.map((n) => (
        <li>
          {dates(n)}: {t(n.entry.title, lang)}, {org(n)} ({trackName(n)}). {t(n.entry.line, lang)}
          {n.entry.milestones?.map((m) => ` ${formatMonth(m.when, lang)}: ${t(m.text, lang)}.`)}
        </li>
      ))
    }
  </ol>
</figure>

<script is:inline>
  // On the first visit of a session the roll records itself once, silently. Hide the notes before
  // the first paint so they can be drawn in; the script below starts the drawing.
  (() => {
    const roll = document.currentScript.previousElementSibling;
    if (matchMedia("(prefers-reduced-motion: reduce)").matches) return;
    try {
      if (sessionStorage.getItem("roll-played")) return;
      sessionStorage.setItem("roll-played", "1");
    } catch {}
    roll.classList.add("playing", "intro");
    roll.style.setProperty("--p", "0");
    // Never leave the notes hidden if the script doesn't run.
    setTimeout(() => roll.classList.contains("intro") && roll.classList.remove("playing", "intro"), 6000);
  })();
</script>

<script>
  // Sound: a small piano made from oscillators, so nothing is downloaded. One bar per year, on the
  // chords I–V–vi–IV in C; every note takes the chord of the year it starts in, its pitch rising with
  // its row, so the left hand (engineering) sounds low and the right hand (leadership) high.
  let audio: { ctx: AudioContext; out: GainNode } | undefined;
  // Browsers only start sound inside a click, so Play calls this before anything is struck.
  const unlock = () => {
    if (!audio) {
      const ctx = new AudioContext();
      const out = ctx.createGain();
      out.gain.value = 0.5;
      out.connect(ctx.createDynamicsCompressor()).connect(ctx.destination);
      audio = { ctx, out };
    }
    if (audio.ctx.state !== "running") audio.ctx.resume();
    return audio;
  };
  const strike = (midi: number, velocity: number) => {
    const { ctx, out } = unlock();
    const at = ctx.currentTime + 0.01;
    const f = 440 * 2 ** ((midi - 69) / 12);
    const tone = ctx.createBiquadFilter();
    tone.frequency.setValueAtTime(Math.min(f * 7, 9000), at);
    tone.frequency.exponentialRampToValueAtTime(Math.max(f * 1.5, 300), at + 1.6);
    const env = ctx.createGain();
    env.gain.setValueAtTime(0.0001, at);
    env.gain.exponentialRampToValueAtTime(velocity, at + 0.006);
    env.gain.exponentialRampToValueAtTime(0.0001, at + 2.6);
    tone.connect(env).connect(out);
    for (const [type, partial, level] of [["triangle", 1, 1], ["sine", 2, 0.35], ["sine", 3, 0.1]] as const) {
      const osc = ctx.createOscillator();
      const gain = ctx.createGain();
      osc.type = type;
      osc.frequency.value = f * partial;
      gain.gain.value = level;
      osc.connect(gain).connect(tone);
      osc.start(at);
      osc.stop(at + 2.7);
    }
  };
  const chords = [[0, 4, 7], [7, 11, 2], [9, 0, 4], [5, 9, 0]];
  const roots = [36, 43, 45, 41];
  const pitch = (fromBottom: number, chord: number[]) => {
    let midi = 52 + 5 * fromBottom;
    while (!chord.includes(midi % 12)) midi++;
    return midi;
  };

  let soundOn = true;
  try {
    soundOn = localStorage.getItem("roll-sound") !== "off";
  } catch {}
  const calm = matchMedia("(prefers-reduced-motion: reduce)");

  for (const roll of document.querySelectorAll<HTMLElement>(".roll")) {
    const months = Number(roll.dataset.months);
    const first = Number(roll.dataset.first);
    const rows = Number(roll.dataset.rows);
    const monthName = new Intl.DateTimeFormat(document.documentElement.lang, { month: "short", year: "numeric" });
    const playBtn = roll.querySelector<HTMLButtonElement>(".playBtn")!;
    const soundBtn = roll.querySelector<HTMLButtonElement>(".soundBtn")!;
    const readouts = roll.querySelectorAll<HTMLElement>(".readout");
    const keys = [...roll.querySelectorAll<HTMLElement>(".key")];
    const scroller = roll.querySelector<HTMLElement>(".h")!;
    const plot = roll.querySelector<HTMLElement>(".hPlot")!;

    // Each note as music: both views' buttons, where it starts and ends (fractions of the axis) and its pitch.
    const music = [...roll.querySelectorAll<HTMLButtonElement>(".note")].map((el) => {
      const x = Number(el.dataset.x);
      const end = x + Number(el.dataset.w);
      const fromBottom = rows - 1 - Number(el.dataset.row);
      const bar = Math.floor((x * months) / 12);
      return {
        els: roll.querySelectorAll<HTMLButtonElement>(`[data-order="${el.dataset.order}"]`),
        x,
        end,
        row: Number(el.dataset.row),
        fromBottom,
        midi: pitch(fromBottom, chords[bar % 4]),
      };
    });
    const sounding = (at: number) => music.filter((m) => m.x <= at && (at < m.end || m.end >= 0.9999));

    const setKeys = (at: number | undefined) => {
      const down = new Set(at === undefined ? [] : sounding(at).map((m) => m.row));
      keys.forEach((key, r) => key.classList.toggle("down", down.has(r)));
    };
    const setReadout = (at: number) => {
      const label = at >= 0.9999 ? roll.dataset.now! : monthName.format(new Date(first, Math.floor(at * months)));
      for (const r of readouts) r.textContent = label;
    };

    soundBtn.setAttribute("aria-pressed", String(soundOn));
    soundBtn.addEventListener("click", () => {
      soundOn = !soundOn;
      for (const b of document.querySelectorAll(".soundBtn")) b.setAttribute("aria-pressed", String(soundOn));
      try {
        localStorage.setItem("roll-sound", soundOn ? "on" : "off");
      } catch {}
    });

    // ---- Playing: the playhead sweeps from 2017 to now, one bar per year. ----
    let raf = 0;
    let done = 0;
    // The silent first-visit drawing leaves the button on Play, so a click then starts the real thing.
    const setPlaying = (on: boolean, button = on) => {
      roll.classList.toggle("playing", on);
      playBtn.classList.toggle("on", button);
      playBtn.querySelector("span")!.textContent = button ? playBtn.dataset.stop! : playBtn.dataset.play!;
    };
    const stop = () => {
      cancelAnimationFrame(raf);
      clearTimeout(done);
      roll.classList.remove("intro", "calm");
      roll.style.setProperty("--p", "1");
      roll.style.setProperty("--c", "1");
      for (const m of music) m.els.forEach((el) => el.classList.remove("struck"));
      setPlaying(false);
      setKeys(undefined);
    };
    const play = (duration: number, withSound: boolean, intro = false) => {
      stop();
      roll.classList.toggle("calm", calm.matches);
      setPlaying(true, !intro);
      const pending = [...music].sort((a, b) => a.x - b.x);
      let bar = -1;
      const start = performance.now();
      const frame = (now: number) => {
        const p = Math.min((now - start) / duration, 1);
        roll.style.setProperty("--p", p.toFixed(4));
        roll.style.setProperty("--c", p.toFixed(4));
        const thisBar = Math.floor((p * months) / 12);
        if (thisBar !== bar && p < 1) {
          bar = thisBar;
          if (withSound) {
            strike(roots[bar % 4], 0.22);
            // Whatever is still sounding is struck again softly, in this year's chord.
            for (const m of sounding(p)) if (m.x * months < bar * 12) strike(pitch(m.fromBottom, chords[bar % 4]), 0.07);
          }
        }
        while (pending.length && pending[0].x <= p) {
          const m = pending.shift()!;
          m.els.forEach((el) => el.classList.add("struck"));
          if (withSound) strike(m.midi, 0.3);
        }
        setKeys(p);
        setReadout(p);
        if (scroller.scrollWidth > scroller.clientWidth) {
          scroller.scrollLeft = plot.offsetLeft + p * plot.offsetWidth - scroller.clientWidth * 0.6;
        }
        if (p < 1) {
          raf = requestAnimationFrame(frame);
          return;
        }
        // At "now", everything still going on rings out as a C major chord.
        if (withSound) {
          strike(36, 0.25);
          strike(48, 0.15);
          for (const m of sounding(1)) strike(pitch(m.fromBottom, chords[0]), 0.22);
        }
        done = window.setTimeout(stop, 1400);
      };
      raf = requestAnimationFrame(frame);
    };

    playBtn.addEventListener("click", () => {
      if (playBtn.classList.contains("on")) return stop();
      if (soundOn) unlock();
      play(Math.round((months / 12) * 850), soundOn);
    });
    document.addEventListener("visibilitychange", () => document.hidden && playBtn.classList.contains("on") && stop());

    // The first visit's silent drawing, once the roll is in view (the inline script set it up).
    if (roll.classList.contains("intro")) {
      new IntersectionObserver((entries, observer) => {
        if (!entries[0].isIntersecting) return;
        observer.disconnect();
        play(2600, false, true);
      }, { threshold: 0.35 }).observe(roll);
    }

    // ---- Scrubbing: with a mouse, the roll shows what was going on at the pointer. ----
    plot.addEventListener("pointermove", (e) => {
      if (e.pointerType !== "mouse" || roll.classList.contains("playing")) return;
      const r = plot.getBoundingClientRect();
      const at = Math.min(Math.max((e.clientX - r.left) / r.width, 0), 1);
      roll.classList.add("scrubbing");
      roll.style.setProperty("--c", at.toFixed(4));
      const on = new Set(sounding(at));
      for (const m of music) m.els.forEach((el) => el.classList.toggle("on", on.has(m)));
      setKeys(at);
      setReadout(at);
    });
    plot.addEventListener("pointerleave", () => {
      if (!roll.classList.contains("scrubbing")) return;
      roll.classList.remove("scrubbing");
      roll.style.setProperty("--c", "1");
      for (const m of music) m.els.forEach((el) => el.classList.remove("on"));
      setKeys(undefined);
    });

    // Once the roll has been played with sound, the notes and keys sound when touched.
    for (const m of music) {
      m.els[0].addEventListener("pointerenter", (e) => {
        if (audio && soundOn && e.pointerType === "mouse" && !roll.classList.contains("playing")) strike(m.midi, 0.12);
      });
    }
    keys.forEach((key, r) =>
      key.addEventListener("pointerdown", () => {
        if (!soundOn) return;
        unlock();
        strike(pitch(rows - 1 - r, chords[0]), 0.25);
        key.classList.add("down");
        setTimeout(() => key.classList.remove("down"), 220);
      }),
    );
  }

  // ---- Popovers on hover and keyboard focus, and the arrow keys. Tapping a note opens its popover
  // without any of this (popovertarget). ----
  const visible = (el: Element) => (el as HTMLElement).offsetParent !== null;

  for (const roll of document.querySelectorAll<HTMLElement>(".roll")) {
    const notes = () =>
      [...roll.querySelectorAll<HTMLButtonElement>(".note, .vNote")]
        .filter(visible)
        .sort((a, b) => Number(a.dataset.order) - Number(b.dataset.order));
    const popOf = (note: HTMLButtonElement) => document.getElementById(note.getAttribute("popovertarget")!)!;

    const place = (note: HTMLButtonElement, pop: HTMLElement) => {
      const r = note.getBoundingClientRect();
      const p = pop.getBoundingClientRect();
      const margin = 8;
      let top = r.top - p.height - margin;
      if (top < margin) top = r.bottom + margin;
      const left = Math.min(Math.max(r.left + Math.min(r.width, 40) / 2 - 24, margin), innerWidth - p.width - margin);
      pop.style.top = `${Math.round(top)}px`;
      pop.style.left = `${Math.round(left)}px`;
    };

    let hideTimer = 0;
    const show = (note: HTMLButtonElement) => {
      clearTimeout(hideTimer);
      const pop = popOf(note);
      if (!pop.matches(":popover-open")) pop.showPopover();
      place(note, pop);
    };
    const hideSoon = (note: HTMLButtonElement) => {
      const pop = popOf(note);
      hideTimer = window.setTimeout(() => {
        if (!pop.matches(":hover, :focus-within") && document.activeElement !== note && pop.matches(":popover-open")) pop.hidePopover();
      }, 200);
    };

    for (const note of roll.querySelectorAll<HTMLButtonElement>(".note, .vNote")) {
      const pop = popOf(note);
      pop.addEventListener("toggle", (e) => {
        if ((e as ToggleEvent).newState === "open") place(note, pop);
      });
      pop.addEventListener("pointerleave", () => hideSoon(note));
      note.addEventListener("pointerenter", (e) => e.pointerType === "mouse" && !roll.classList.contains("playing") && show(note));
      note.addEventListener("pointerleave", (e) => e.pointerType === "mouse" && hideSoon(note));
      note.addEventListener("focus", () => note.matches(":focus-visible") && show(note));
      note.addEventListener("blur", () => hideSoon(note));
      // Once hover or focus has opened the popover, a click keeps it open instead of toggling it shut.
      note.addEventListener("click", (e) => {
        if (pop.matches(":popover-open") && (note.matches(":hover") || note.matches(":focus-visible"))) e.preventDefault();
      });
      note.addEventListener("keydown", (e) => {
        const list = notes();
        const i = list.indexOf(note);
        const next = { ArrowRight: i + 1, ArrowDown: i + 1, ArrowLeft: i - 1, ArrowUp: i - 1, Home: 0, End: list.length - 1 }[e.key];
        if (next === undefined || !list[next]) return;
        e.preventDefault();
        for (const n of list) n.tabIndex = -1;
        list[next].tabIndex = 0;
        list[next].focus();
      });
    }

    // On a narrow screen the wide roll scrolls in its own box; start it at "now".
    const scroller = roll.querySelector<HTMLElement>(".h");
    if (scroller && scroller.scrollWidth > scroller.clientWidth) scroller.scrollLeft = scroller.scrollWidth;
  }
</script>

<style>
  .roll {
    position: relative;
    margin: 0;
    --pitch: 32px;
    --noteH: 24px;
    --headroom: 26px;
    --trackW: 112px;
    --keysW: 64px;
    --keyWhite: #ffffff;
    --keyBlack: #13201c;
    --keyEdge: rgba(19, 32, 28, 0.07);
  }
  @media (prefers-color-scheme: dark) {
    :root:not([data-theme="light"]) .roll {
      --keyWhite: #b8c3bf;
      --keyBlack: #070b0a;
      --keyEdge: rgba(0, 0, 0, 0.18);
    }
  }
  :root[data-theme="dark"] .roll {
    --keyWhite: #b8c3bf;
    --keyBlack: #070b0a;
    --keyEdge: rgba(0, 0, 0, 0.18);
  }

  /* ---- Transport ---- */
  .transport {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px 10px;
    margin-bottom: 16px;
  }
  /* Where the roll is wide enough, the transport sits in its top-left corner, which stays empty:
     nothing on the roll starts before autumn 2019, and no label may go there (lib/roll.ts). */
  @media (min-width: 1280px) {
    .transport {
      position: absolute;
      z-index: 4;
      top: calc(var(--headroom) + 4px);
      left: calc(var(--trackW) + var(--keysW) + 16px);
      margin: 0;
