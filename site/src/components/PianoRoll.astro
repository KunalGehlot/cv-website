  .playing:not(.calm) .vNote {
    --fill: clamp(0, (var(--p) - var(--y)) / var(--len), 1);
    --whole: clamp(0, (var(--fill) - 0.999) * 1000, 1);
    clip-path: inset(-400px -400px calc((1 - var(--fill)) * 100% + 1px - var(--whole) * 2000px) -400px);
  }
  @keyframes strike {
    from {
