  /* Playing: each note is drawn as the playhead passes it, and flares when it is struck. Its
     label beside it appears once the note is complete. */
  .playing:not(.calm) .note {
    --fill: clamp(0, (var(--p) - var(--x)) / var(--w), 1);
    --whole: clamp(0, (var(--fill) - 0.999) * 1000, 1);
    clip-path: inset(-8px calc((1 - var(--fill)) * 100% + 1px - var(--whole) * 400px) -8px -400px);
  }
  .playing:not(.calm) :is(.note, .vNote):not(.struck) .label {
    visibility: hidden;
