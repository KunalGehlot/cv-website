  .vNow span,
  .vCursor span {
    position: absolute;
    top: 4px;
    left: 0;
    font-size: 12px;
    font-weight: 600;
  }
  .vNote {
    top: calc(var(--y) * var(--vh));
    height: max(calc(var(--len) * var(--vh) - 2px), 6px);
    width: var(--bar);
    border-radius: 3px;
  }
  .vNote[data-track="eng"] {
    left: calc(var(--center) - 6px - var(--lane) * var(--step) - var(--bar));
  }
  .vNote[data-track="lead"] {
    left: calc(var(--center) + 6px + var(--lane) * var(--step));
  }
  .vNote[data-track="both"] {
    left: calc(var(--center) - 6px);
    width: 12px;
  }
  .vNote .label {
    top: calc(var(--ly) - var(--y) * var(--vh));
    font-size: 12px;
    line-height: var(--line);
    white-space: normal;
    color: var(--ink);
  }
  /* Label columns: from the years to the outermost engineering lane, and from the outermost
     leadership lane to the edge. Offsets are relative to the note the label belongs to.
     Engineering labels sit left of their lanes, right-aligned; the others sit right of theirs. */
  .vNote[data-track="eng"] .label {
    text-align: right;
    right: calc((var(--eng) - 1 - var(--lane)) * var(--step) + var(--bar) + 6px);
    width: calc(var(--center) - 12px - (var(--eng) - 1) * var(--step) - var(--bar) - var(--yearsW) - 4px);
  }
  .vNote[data-track="lead"] .label,
  .vNote[data-track="both"] .label {
    left: calc((var(--lead) - 1 - var(--lane)) * var(--step) + var(--bar) + 6px);
    width: calc(100cqw - var(--center) - 12px - (var(--lead) - 1) * var(--step) - var(--bar));
  }
  .vNote[data-track="both"] .label {
    left: calc(12px + (var(--lead) - 1) * var(--step) + var(--bar) + 6px);
  }

  .legend {
