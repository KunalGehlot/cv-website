---
const { active = "en", langLinks } = Astro.props;
const isEN = active === "en";
const linkEN = langLinks?.en ?? "/en/";
const linkDE = langLinks?.de ?? "/de/";
const brandHref = isEN ? "/en/" : "/de/";
---

<header>
  <div class="container">
    <div class="nav">
      <a class="brand" href={brandHref}>Kunal Gehlot</a>

      <div class="navRight">
        <a class="navLink" href={isEN ? "/en/story/" : "/de/story/"}>{isEN ? "Story" : "Story"}</a>
        <a class="navLink" href={isEN ? "/en/#contact" : "/de/#contact"}>{isEN ? "Contact" : "Kontakt"}</a>

        <div class="langPill">
          <a href={linkEN} class={isEN ? "active" : ""}>EN</a>
          <a href={linkDE} class={!isEN ? "active" : ""}>DE</a>
        </div>

        <a class="btn btnPrimary" href={isEN ? "/cv/cv-en.pdf" : "/cv/cv-de.pdf"} target="_blank" rel="noopener">
          {isEN ? "Download CV" : "CV herunterladen"}
        </a>
      </div>
    </div>
  </div>
</header>
