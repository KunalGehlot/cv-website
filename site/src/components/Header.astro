---
const { active = "en", langLinks } = Astro.props;
const isEN = active === "en";
const base = import.meta.env.BASE_URL;
const href = (p) => `${base}${p.replace(/^\//, "")}`;
const linkEN = href(langLinks?.en ?? "en/");
const linkDE = href(langLinks?.de ?? "de/");
const brandHref = isEN ? href("en/") : href("de/");
---

<header>
  <div class="container">
    <div class="nav">
      <a class="brand" href={brandHref}>Kunal Gehlot</a>

      <div class="navRight">
        <a class="navLink" href={isEN ? href("en/story/") : href("de/story/")}>{isEN ? "Story" : "Story"}</a>
        <a class="navLink" href={isEN ? href("en/#contact") : href("de/#contact")}>{isEN ? "Contact" : "Kontakt"}</a>

        <div class="langPill">
          <a href={linkEN} class={isEN ? "active" : ""}>EN</a>
          <a href={linkDE} class={!isEN ? "active" : ""}>DE</a>
        </div>

        <a class="btn btnPrimary" href={isEN ? href("cv/cv-en.pdf") : href("cv/cv-de.pdf")} target="_blank" rel="noopener">
          {isEN ? "Download CV" : "CV herunterladen"}
        </a>
      </div>
    </div>
  </div>
</header>
