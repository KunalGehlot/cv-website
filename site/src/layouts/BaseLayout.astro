---
import "../styles/global.css";

const { title = "Kunal Gehlot", lang = "en" } = Astro.props;
const descriptions = {
  en: "I build future ready products and organizations, where engineering, management, and entrepreneurial thinking meet.",
  de: "Ich gestalte zukunftsfähige Produkte und Organisationen, an der Schnittstelle von Engineering, Management und Unternehmertum.",
};
const description = descriptions[lang] ?? descriptions.en;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
  </head>
  <body>
    <slot />
  </body>
</html>
