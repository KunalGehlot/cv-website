---
import "../styles/global.css";

const { title = "Kunal Gehlot", lang = "en" } = Astro.props;
const base = import.meta.env.BASE_URL;
const descriptions = {
  en: "I build future ready products and organizations, where engineering, management, and entrepreneurial thinking meet.",
  de: "Ich gestalte zukunftsfähige Produkte und Organisationen, an der Schnittstelle von Engineering, Management und Unternehmertum.",
};
const description = descriptions[lang] ?? descriptions.en;
const path = Astro.url?.pathname ?? "/";
const pathWithoutBase = path.startsWith(base) ? `/${path.slice(base.length)}` : path;
const canonicalPath = `${base}${pathWithoutBase.replace(/^\//, "")}`;
const isEn = pathWithoutBase.startsWith("/en/");
const isDe = pathWithoutBase.startsWith("/de/");
const altEnPath = isEn ? pathWithoutBase : isDe ? pathWithoutBase.replace(/^\/de\//, "/en/") : "/en/";
const altDePath = isDe ? pathWithoutBase : isEn ? pathWithoutBase.replace(/^\/en\//, "/de/") : "/de/";
const toUrl = (p) => (Astro.site ? new URL(p, Astro.site).toString() : p);
const canonical = toUrl(canonicalPath);
const altEn = toUrl(`${base}${altEnPath.replace(/^\//, "")}`);
const altDe = toUrl(`${base}${altDePath.replace(/^\//, "")}`);
const locale = lang === "de" ? "de_DE" : "en_US";
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="index,follow,max-snippet:-1,max-image-preview:large,max-video-preview:-1" />
    <meta name="googlebot" content="index,follow" />
    <meta name="author" content="Kunal Gehlot" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={locale} />
    <meta property="og:site_name" content="Kunal Gehlot" />
    <meta name="twitter:card" content="summary" />
    {canonical ? <meta property="og:url" content={canonical} /> : null}
    {canonical ? <link rel="canonical" href={canonical} /> : null}
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <link rel="alternate" hreflang="en" href={altEn} />
    <link rel="alternate" hreflang="de" href={altDe} />
    <link rel="alternate" hreflang="x-default" href={altEn} />
  </head>
  <body>
    <slot />
    <script>
      // Disable context menu, text selection, and copying
      const suppress = (event) => event.preventDefault();
      document.addEventListener("contextmenu", suppress);
      document.addEventListener("selectstart", suppress);
      document.addEventListener("copy", suppress);
    </script>
  </body>
</html>
